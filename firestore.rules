rules_version = '2';

// Multi-tenant Gift Planner rules.
//
// Each household is a separate Firestore document. A user's membership is
// recorded in userHouseholds/{uid}. The household invite code lives in
// inviteCodes/{code}.
//
// LEGACY RULE: the original "main" household is still readable/writable by
// the two founding emails during the migration window. Once both users have
// been auto-migrated (userHouseholds docs created), the legacy block can be
// removed and the rules re-published.
//
// Paste into: Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own membership record — only they can read/write it.
    match /userHouseholds/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Invite codes — any signed-in user can read (to join), any can create.
    match /inviteCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
    }

    match /households/{householdId} {
      // New rule: authenticated users who are members of this household.
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/userHouseholds/$(request.auth.uid))
        && get(/databases/$(database)/documents/userHouseholds/$(request.auth.uid)).data.householdId == householdId;

      // New household creation: the creator sets adminUid = their own uid.
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid;

      // LEGACY: original two users can still access "main" while migration runs.
      allow read, write: if request.auth != null
        && householdId == "main"
        && request.auth.token.email in [
             "smithdk44@gmail.com",
             "megan.howe@live.com.au"
           ];
    }

    // Feedback submissions — any signed-in user can create; no one can read.
    match /feedback/{docId} {
      allow create: if request.auth != null;
    }
  }
}
